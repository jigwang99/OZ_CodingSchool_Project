--- !u!114 &1758102818556188750
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3224263212197733063}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a4a276c328bf0984ebaab64a7767c689, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AutoBattler.Presentation.Battle.ControlHelpView
  topics:
  - button: {fileID: 2774309197694160740}
    title: "\uC720\uB2DB \uBC30\uCE58"
    instructions: "\uC544\uAD70\uC744 \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC73C\uB85C
      \uB4DC\uB798\uADF8\uD574 \uC804\uC7A5\uC774\uB098 \uB300\uAE30\uC11D\uC5D0
      \uB193\uC73C\uC138\uC694. \uB2E4\uB978 \uC544\uAD70\uC774 \uC788\uB294 \uCE78\uC5D0
      \uB193\uC73C\uBA74 \uC790\uB9AC\uB97C \uBC14\uAFC9\uB2C8\uB2E4.\n\n\uC720\uB2DB\uC744
      \uD074\uB9AD\uD558\uBA74 \uB2A5\uB825\uCE58, \uC2A4\uD0AC, \uD310\uB9E4 \uAC00\uACA9\uACFC
      \uC7A5\uBE44\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uD50C\uB808\uC774\uC5B4
      \uB808\uBCA8\uB9CC\uD07C \uC804\uC7A5\uC5D0 \uBC30\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC544\uAD70\uC744 1\uAE30 \uC774\uC0C1 \uBC30\uCE58\uD558\uACE0 \uC804\uD22C
      \uC2DC\uC791\uC744 \uB204\uB974\uC138\uC694."
  - button: {fileID: 3439295116060083466}
    title: "\uC0C1\uC810\xB7\uB808\uBCA8"
    instructions: "\uD558\uB2E8 \uC0C1\uC810 \uCE74\uB4DC\uB97C \uD074\uB9AD\uD558\uBA74
      \uC720\uB2DB\uC744 \uAD6C\uB9E4\uD569\uB2C8\uB2E4. \uC720\uB2DB\uC744 \uB4DC\uB798\uADF8\uD588\uC744
      \uB54C \uB098\uD0C0\uB098\uB294 \uD558\uB2E8 \uD310\uB9E4 \uAD6C\uC5ED\uC5D0
      \uB193\uC73C\uBA74 \uD310\uB9E4\uD569\uB2C8\uB2E4.\n\nD\uD0A4\uB85C \uC0C1\uC810\uC744
      \uC0C8\uB85C\uACE0\uCE68\uD558\uACE0 F\uD0A4\uB85C \uACBD\uD5D8\uCE58\uB97C
      \uAD6C\uB9E4\uD569\uB2C8\uB2E4. \uC804\uD22C \uC911\uC5D0\uB3C4 \uAD6C\uB9E4\uC640
      \uB300\uAE30\uC11D \uC720\uB2DB \uD310\uB9E4\uAC00 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\n\uAC19\uC740
      \uC885\uB958\uC640 \uC131\uAE09\uC758 \uC720\uB2DB 3\uAE30\uAC00 \uBAA8\uC774\uBA74
      \uC790\uB3D9\uC73C\uB85C \uD55C \uC131\uAE09 \uC62C\uB77C\uAC11\uB2C8\uB2E4."
  - button: {fileID: 220752625535261024}
    title: "\uC804\uD22C\xB7\uC2DC\uB108\uC9C0"
    instructions: "\uC804\uD22C\uAC00 \uC2DC\uC791\uB418\uBA74 \uC720\uB2DB\uC740
      \uC790\uB3D9\uC73C\uB85C \uC774\uB3D9\uD558\uACE0 \uACF5\uACA9\uD569\uB2C8\uB2E4.
      \uC804\uD22C \uC911\uC5D0\uB294 \uC804\uC7A5 \uC720\uB2DB\uC758 \uBC30\uCE58\uB97C
      \uBC14\uAFC0 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\n\uC67C\uCABD \uC2DC\uB108\uC9C0\uC5D0
      \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB9AC\uBA74 \uD6A8\uACFC\uB97C, \uC624\uB978\uCABD
      \uC804\uD22C \uD1B5\uACC4\uC5D0\uC11C \uAC00\uD55C \uD53C\uD574\xB7\uBC1B\uC740
      \uD53C\uD574\xB7\uD68C\uBCF5\uB7C9\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC77C\uBC18
      \uC804\uD22C\uB294 \uACB0\uACFC\uAC00 \uD45C\uC2DC\uB41C \uB4A4 5\uCD08 \uD6C4
      \uBCF4\uC0C1\uC744 \uBC1B\uACE0 \uB2E4\uC74C \uC900\uBE44 \uB2E8\uACC4\uB85C
      \uB118\uC5B4\uAC11\uB2C8\uB2E4."
  - button: {fileID: 5374925652397253686}
    title: "\uC544\uC774\uD15C"
    instructions: "\uC88C\uD558\uB2E8 \uBCF4\uAD00\uD568\uC744 \uC5F4\uACE0 \uC7AC\uB8CC\uB97C
      \uD074\uB9AD\uD558\uBA74 \uC870\uD569\uD45C\uAC00 \uB098\uC635\uB2C8\uB2E4.
      \uC544\uC774\uD15C\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB9AC\uBA74 \uC774\uB984\uACFC
      \uB2A5\uB825\uCE58\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC544\uC774\uD15C\uC744
      \uC544\uAD70 \uC704\uC5D0 \uB193\uC73C\uBA74 \uC7A5\uCC29\uD569\uB2C8\uB2E4.
      \uC7AC\uB8CC\uB97C \uACB9\uCCD0 \uB193\uAC70\uB098 \uC870\uD569 \uAC00\uB2A5\uD55C
      \uC7A5\uBE44\uB97C \uAC00\uC9C4 \uC720\uB2DB\uC5D0\uAC8C \uC7AC\uB8CC\uB97C
      \uB193\uC73C\uBA74 \uD569\uC131\uD569\uB2C8\uB2E4.\n\n\uC720\uB2DB\uB2F9 3\uAC1C\uAE4C\uC9C0
      \uC7A5\uCC29\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC900\uBE44 \uC911 \uC720\uB2DB
      \uC815\uBCF4\uCC3D\uC5D0\uC11C \uC7A5\uBE44\uB97C \uC6B0\uD074\uB9AD\uD558\uBA74
      \uD574\uC81C\uD569\uB2C8\uB2E4."
  - button: {fileID: 9050629558252735320}
    title: "\uC99D\uAC15"
    instructions: "\uC138 \uAC00\uC9C0 \uCE74\uB4DC \uC911 \uD558\uB098\uB97C \uC120\uD0DD\uD558\uC138\uC694.
      \uC120\uD0DD \uCC3D\uC744 \uC7A0\uC2DC \uB2EB\uC73C\uBA74 \uC720\uB2DB\uC744
      \uBC30\uCE58\uD560 \uC218 \uC788\uACE0, \uB2E4\uC2DC \uC5F4\uC5B4 \uC99D\uAC15\uC744
      \uC120\uD0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC67C\uCABD \uC99D\uAC15
      \uCE78\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB9AC\uBA74 \uC120\uD0DD\uD55C
      \uD6A8\uACFC\uB97C \uD655\uC778\uD569\uB2C8\uB2E4. \uD6A8\uACFC\uAC00 \uBC1C\uB3D9\uD558\uBA74
      \uD574\uB2F9 \uCE78\uACFC \uC99D\uAC15 \uC774\uB984\uC774 \uC7A0\uAE50 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
  - button: {fileID: 7614254259507582298}
    title: "\uBC30\uCE58\uD234"
    instructions: "\uBC30\uCE58\uD234\uC5D0\uC11C \uC720\uB2DB\uC744 \uC120\uD0DD\uD558\uAC70\uB098
      \uB4DC\uB798\uADF8\uD574 \uB193\uC73C\uBA74 \uC2DC\uB108\uC9C0\uB97C \uBBF8\uB9AC
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCE78 \uC704\uC5D0\uC11C
      \uC6B0\uD074\uB9AD\uD558\uBA74 \uC720\uB2DB\uC744 \uC81C\uAC70\uD569\uB2C8\uB2E4.\n\n\uD604\uC7AC
      \uBC30\uCE58 \uAC00\uC838\uC624\uAE30\uB85C \uC804\uC7A5 \uD3B8\uC131\uC744
      \uBD88\uB7EC\uC624\uACE0, \uD68C\uC0C9\uC73C\uB85C \uD45C\uC2DC\uB41C \uBBF8\uD574\uAE08
      \uC720\uB2DB\uB3C4 \uD568\uAED8 \uBC30\uCE58\uD574 \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  topicTitle: {fileID: 4256473302007114980}
  instructions: {fileID: 2874626397996816555}
  backButton: {fileID: 6090694743143454506}
  closeButton: {fileID: 2247764574096838050}
